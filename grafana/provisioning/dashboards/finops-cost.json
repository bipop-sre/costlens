    {
      "id": 9,
      "title": "本月 Top 10 服务",
      "type": "table",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "finops-sqlite"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "finops-sqlite"
          },
          "rawSql": "SELECT service_name AS 服务名称, ROUND(SUM(cost), 2) AS 成本, ROUND(SUM(cost) * 100.0 / (SELECT SUM(cost) FROM v_service_cost WHERE year=2026 AND month=8), 1) AS 占比 FROM v_service_cost WHERE year=2026 AND month=8 GROUP BY service_name ORDER BY SUM(cost) DESC LIMIT 10",
          "format": "table"
        }
      ],
      "description": "",
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 10,
      "title": "Top 10 服务月度趋势",
      "type": "table",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "finops-sqlite"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "finops-sqlite"
          },
          "rawSql": "SELECT service_name AS 服务名称, ROUND(SUM(CASE WHEN month=5 THEN cost ELSE 0 END), 2) AS \"5月\", ROUND(SUM(CASE WHEN month=6 THEN cost ELSE 0 END), 2) AS \"6月\", ROUND(SUM(CASE WHEN month=7 THEN cost ELSE 0 END), 2) AS \"7月\", ROUND(SUM(CASE WHEN month=8 THEN cost ELSE 0 END), 2) AS \"8月\" FROM v_service_trend WHERE service_name IN (SELECT service_name FROM v_service_trend WHERE year=2026 AND month=8 GROUP BY service_name ORDER BY SUM(cost) DESC LIMIT 10) GROUP BY service_name ORDER BY SUM(CASE WHEN month=8 THEN cost ELSE 0 END) DESC",
          "format": "table"
        }
      ],
      "description": "",
      "options": {
        "showHeader": true
      }
    },
