    {
      "id": 305,
      "title": "每日环比变化",
      "type": "timeseries",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "finops-sqlite"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 62
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "finops-sqlite"
          },
          "rawSql": "\nSELECT t1.date,\n    ROUND(t1.total_daily, 2) AS today_cost,\n    CASE WHEN t2.total_daily > 0\n        THEN ROUND((t1.total_daily - t2.total_daily) / t2.total_daily * 100, 1)\n        ELSE 0\n    END AS dod_pct\nFROM v_daily_trend t1\nLEFT JOIN v_daily_trend t2 ON t2.date = date(t1.date, '-1 day')\nORDER BY t1.date",
          "format": "table"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {},
